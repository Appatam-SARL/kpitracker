// Prisma schema pour CRM Next.js avec PostgreSQL

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Company {
  id        String   @id @default(cuid())
  name      String
  plan      String   @default("free")
  /// Différencie les entreprises du groupe (GROUP) des entreprises clientes (CLIENT)
  kind      CompanyKind @default(CLIENT)
  createdAt DateTime @default(now())

  users      User[]
  deals      Deal[]
  clients    Client[]
  products   Product[]
  services   Service[]
  salesGoals SalesGoal[]
  /// Ventes réalisées pour cette société
  sales      Sale[]
  /// Journal des actions utilisateurs sur cette société
  userActionLogs UserActionLog[]
  /// Synthèses de ventes générées
  salesReports   SalesReport[]
}

enum CompanyKind {
  GROUP
  CLIENT
}

model Product {
  id        String   @id @default(cuid())
  name      String
  company   Company  @relation(fields: [companyId], references: [id])
  companyId String
  createdAt DateTime @default(now())
  /// Intérêts exprimés par les contacts prospect pour ce produit
  prospectInterests ProspectProductInterest[]
  /// Intérêts exprimés par les clients pour ce produit, avec valeur estimative
  clientInterests ClientProductInterest[]
  /// Lignes de vente associées à ce produit
  saleItems       SaleItem[]
}

model Service {
  id        String   @id @default(cuid())
  name      String
  company   Company  @relation(fields: [companyId], references: [id])
  companyId String
  createdAt DateTime @default(now())
  /// Intérêts exprimés par les contacts prospect pour ce service
  prospectInterests ProspectServiceInterest[]
  /// Intérêts exprimés par les clients pour ce service, avec valeur estimative
  clientInterests ClientServiceInterest[]
  /// Lignes de vente associées à ce service
  saleItems       SaleItem[]
}

model User {
  id        String   @id @default(cuid())
  name      String
  email     String   @unique
  password  String
  /// Oblige l'utilisateur a changer son mot de passe au premier login
  mustChangePassword Boolean @default(false)
  role      Role     @default(AGENT)
  company   Company  @relation(fields: [companyId], references: [id])
  companyId String
  /// Activation de la double authentification (MFA)
  mfaEnabled Boolean @default(false)
  /// Secret TOTP (base32) pour génération des codes OTP ; présent si MFA configuré ou en attente de vérification
  mfaSecret  String?
  /// Chemin public de l’image signature (/uploads/signatures/…) ou ancien HTML
  emailSignature String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  activities       Activity[]
  clientsConverted Client[]
  /// Éléments d'agenda créés par cet utilisateur
  agendaItemsCreated AgendaItem[]
  /// Objectifs commerciaux assignés à cet utilisateur
  salesGoals       SalesGoal[]
  /// Objectifs que cet utilisateur a définis (manager/admin)
  goalsSetBy       SalesGoal[] @relation("SalesGoalSetBy")
  /// Ventes réalisées par ce commercial
  sales            Sale[]
  /// Journal des actions effectuées par cet utilisateur
  actionLogs       UserActionLog[]
  /// Jetons de réinitialisation de mot de passe
  passwordResetTokens PasswordResetToken[]
  /// Contacts créés par cet utilisateur sur des prospects entreprise
  prospectContactsCreated ProspectContact[] @relation("ProspectContactCreatedBy")
  /// Entreprises prospectées créées par cet utilisateur
  prospectsCreated Prospect[] @relation("ProspectCreatedBy")
  /// Intérêts produits proposés par cet utilisateur
  prospectProductInterests ProspectProductInterest[]
  /// Intérêts services proposés par cet utilisateur
  prospectServiceInterests ProspectServiceInterest[]
  /// Rapports de synthèse générés par cet utilisateur
  salesReportsCreated SalesReport[] @relation("SalesReportCreatedBy")
  /// Rapports ciblant ce commercial
  salesReportsAsAgent SalesReport[] @relation("SalesReportAgent")
  /// Mise en corbeille
  deletedAt        DateTime?
  deletedBy        User?     @relation("UserDeletedBy", fields: [deletedById], references: [id], onDelete: SetNull)
  deletedById      String?
  usersDeleted     User[]    @relation("UserDeletedBy")
  prospectsDeleted Prospect[] @relation("ProspectDeletedBy")
  contactsDeleted  ProspectContact[] @relation("ProspectContactDeletedBy")
  goalsDeleted     SalesGoal[] @relation("SalesGoalDeletedBy")
  attachmentsDeleted ProspectAttachment[] @relation("ProspectAttachmentDeletedBy")

  @@index([companyId, deletedAt])
}

/// Jeton de réinitialisation de mot de passe (hashé, usage unique, expiration courte)
model PasswordResetToken {
  id        String    @id @default(cuid())
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    String
  /// SHA-256 du jeton envoyé par e-mail
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId, createdAt])
}

/// Entreprise prospectée (partagée entre toutes les sociétés GROUP)
model Prospect {
  id             String         @id @default(cuid())
  /// Raison sociale / nom commercial
  name           String
  /// Nom normalisé pour unicité / recherche
  nameNormalized String
  source         String?
  /// Secteur d'activités
  activitySector String?
  /// Type de client (TypeClient)
  leadType       LeadTypeClient @default(NON_DETERMINE)
  /// Quartier, commune, ville, pays
  location       String?
  /// Lien de situation géographique (Google Maps, etc.)
  geographicSituation String?
  /// Site web de l'entreprise
  websiteUrl     String?
  /// Logo de l'entreprise (chemin public)
  logoUrl        String?
  /// Pages réseaux sociaux : [{ network, url }]
  socialLinks    Json?
  notes          String?
  /// Stade agrégé (pipeline entreprise) — source de vérité fine = contact
  status         NegotiationStage @default(EN_PROSPECTION)
  /// Utilisateur ayant ajouté l'entreprise dans le système
  createdBy      User?            @relation("ProspectCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  createdById    String?
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  contacts         ProspectContact[]
  activities       Activity[]
  attachments      ProspectAttachment[]
  agendaItems      AgendaItem[]
  activityDomains  ProspectActivityDomain[]
  /// Mise en corbeille
  deletedAt        DateTime?
  deletedBy        User?     @relation("ProspectDeletedBy", fields: [deletedById], references: [id], onDelete: SetNull)
  deletedById      String?

  @@unique([nameNormalized])
  @@index([deletedAt])
  @@index([status])
  @@index([createdById])
}

/// Contact (personne) rattaché à une entreprise prospectée, créé par une commerciale
model ProspectContact {
  id          String   @id @default(cuid())
  prospect    Prospect @relation(fields: [prospectId], references: [id], onDelete: Cascade)
  prospectId  String
  createdBy   User     @relation("ProspectContactCreatedBy", fields: [createdById], references: [id], onDelete: Cascade)
  createdById String
  firstName    String
  lastName     String
  phone        String?
  email        String?
  civility     String?
  jobTitle     String?
  /// Rôle dans la décision (décideur, prescripteur, …)
  decisionRole DecisionRole @default(NON_DETERMINE)
  /// Stade de négociation entre la commerciale et ce contact
  negotiationStage NegotiationStage @default(EN_PROSPECTION)
  notes        String?
  /// Champs spécifiques BIIM (visibles si la commerciale appartient à BIIM)
  /// Types de documents sélectionnés (JSON string[])
  biimDocuments  Json?
  biimRegistered Boolean?
  biimVisited    Boolean?
  biimApproved   Boolean?
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  productInterests ProspectProductInterest[]
  serviceInterests ProspectServiceInterest[]
  activities       Activity[]
  agendaItems      AgendaItem[]
  attachments      ProspectAttachment[]
  /// Mise en corbeille
  deletedAt        DateTime?
  deletedBy        User?     @relation("ProspectContactDeletedBy", fields: [deletedById], references: [id], onDelete: SetNull)
  deletedById      String?

  @@index([prospectId, deletedAt])
  @@index([createdById])
  @@index([negotiationStage])
}

/// Domaine d'activités rattaché à un prospect entreprise
model ProspectActivityDomain {
  id         String   @id @default(cuid())
  prospect   Prospect @relation(fields: [prospectId], references: [id], onDelete: Cascade)
  prospectId String
  domain     String

  @@unique([prospectId, domain])
  @@index([domain])
}

/// Intérêt produit proposé par une commerciale sur un contact
model ProspectProductInterest {
  id             String          @id @default(cuid())
  contact        ProspectContact @relation(fields: [contactId], references: [id], onDelete: Cascade)
  contactId      String
  user           User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId         String
  product        Product?        @relation(fields: [productId], references: [id])
  productId      String?
  customName     String?
  estimatedValue Float           @default(0)
  createdAt      DateTime        @default(now())

  @@unique([contactId, userId, productId])
  @@unique([contactId, userId, customName])
  @@index([userId])
}

/// Intérêt service proposé par une commerciale sur un contact
model ProspectServiceInterest {
  id             String          @id @default(cuid())
  contact        ProspectContact @relation(fields: [contactId], references: [id], onDelete: Cascade)
  contactId      String
  user           User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId         String
  service        Service?        @relation(fields: [serviceId], references: [id])
  serviceId      String?
  customName     String?
  estimatedValue Float           @default(0)
  createdAt      DateTime        @default(now())

  @@unique([contactId, userId, serviceId])
  @@unique([contactId, userId, customName])
  @@index([userId])
}

/// Pièce jointe d'un prospect entreprise (optionnellement liée à un contact)
model ProspectAttachment {
  id          String    @id @default(cuid())
  prospect    Prospect  @relation(fields: [prospectId], references: [id], onDelete: Cascade)
  prospectId  String
  /// Contact associé (ex. documents BIIM uploadés à l'enregistrement)
  contact     ProspectContact? @relation(fields: [contactId], references: [id], onDelete: SetNull)
  contactId   String?
  /// Libellé métier (ex. Agrément du Ministère du Tourisme)
  label       String?
  fileName    String
  fileType    String
  fileSize    Int
  storagePath String
  createdAt   DateTime  @default(now())
  deletedAt   DateTime?
  deletedBy   User?     @relation("ProspectAttachmentDeletedBy", fields: [deletedById], references: [id], onDelete: SetNull)
  deletedById String?

  @@index([prospectId, deletedAt])
  @@index([contactId, deletedAt])
}

model Deal {
  id         String   @id @default(cuid())
  title      String
  amount     Float
  stage      String
  probability Int?
  expectedCloseDate DateTime?
  assignedTo String?
  company   Company  @relation(fields: [companyId], references: [id])
  companyId String
}

model Client {
  id        String   @id @default(cuid())
  name      String
  /// Contact principal (téléphone ou email synthétique)
  contact   String?
  /// Email du client (copié depuis le lead)
  email     String?
  /// Téléphone du client (copié depuis le lead)
  phone     String?
  /// Source d'acquisition (ex: Facebook, LinkedIn, Tik Tok...)
  source    String?
  /// Civilité (M., Mme, etc.)
  civility  String?
  /// Domaine d'activités (secteur)
  activityDomain String?
  /// Nom de la société côté client (copié depuis companyName du lead)
  companyName    String?
  /// Localisation / adresse
  location       String?
  /// Notes sur le client (observations)
  notes          String?
  /// Chiffre d'affaires total généré par ce client (somme des ventes)
  totalRevenue Float  @default(0)

  company   Company  @relation(fields: [companyId], references: [id])
  companyId String

  /// Ventes réalisées pour ce client
  sales     Sale[]

  /// Utilisateur ayant converti le prospect en client
  convertedById String?
  convertedAt   DateTime?
  convertedBy   User?   @relation(fields: [convertedById], references: [id])
  /// Prospect entreprise d'origine (optionnel)
  convertedFromProspectId String?
  /// Produits pour lesquels le client est intéressé, avec valeur estimative
  productInterests ClientProductInterest[]
  /// Services pour lesquels le client est intéressé, avec valeur estimative
  serviceInterests ClientServiceInterest[]
}

/// Lien entre un client et un produit, avec une valeur estimative associée
model ClientProductInterest {
  id            String   @id @default(cuid())
  client        Client   @relation(fields: [clientId], references: [id])
  clientId      String
  product       Product  @relation(fields: [productId], references: [id])
  productId     String
  /// Valeur estimative associée à ce produit pour ce client
  estimatedValue Float   @default(0)
  createdAt     DateTime @default(now())

  @@unique([clientId, productId])
}

/// Lien entre un client et un service, avec une valeur estimative associée
model ClientServiceInterest {
  id            String   @id @default(cuid())
  client        Client   @relation(fields: [clientId], references: [id])
  clientId      String
  service       Service  @relation(fields: [serviceId], references: [id])
  serviceId     String
  /// Valeur estimative associée à ce service pour ce client
  estimatedValue Float   @default(0)
  createdAt     DateTime @default(now())

  @@unique([clientId, serviceId])
}

/// Vente (commande) réalisée pour un client, par un commercial, pour une société
model Sale {
  id        String   @id @default(cuid())
  client    Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)
  clientId  String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    String
  company   Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  companyId String
  /// Date effective de la vente
  date      DateTime
  /// Montant total de la vente (somme des lignes)
  amount    Float
  createdAt DateTime @default(now())

  items     SaleItem[]
}

/// Détail de ligne d'une vente (produit ou service vendu)
model SaleItem {
  id        String   @id @default(cuid())
  sale      Sale     @relation(fields: [saleId], references: [id], onDelete: Cascade)
  saleId    String
  product   Product? @relation(fields: [productId], references: [id])
  productId String?
  service   Service? @relation(fields: [serviceId], references: [id])
  serviceId String?
  quantity  Int
  unitPrice Float
  lineTotal Float
}

model Activity {
  id         String            @id @default(cuid())
  type       ActivityType
  relatedTo  String
  prospect   Prospect?         @relation(fields: [prospectId], references: [id], onDelete: SetNull)
  prospectId String?
  contact    ProspectContact?  @relation(fields: [contactId], references: [id], onDelete: SetNull)
  contactId  String?
  user       User              @relation(fields: [userId], references: [id])
  userId     String
  date       DateTime          @default(now())
  content    String

  @@index([prospectId])
  @@index([contactId])
}

enum Role {
  ADMIN
  MANAGER
  DIRECTRICE_COMMERCIALE
  PDG
  DIRECTRICE_OPERATION
  AGENT
}

/// Stade de négociation (commerciale ↔ contact au sein de l'entreprise prospectée)
enum NegotiationStage {
  EN_PROSPECTION
  VENTE_CONCLUE
  VENTE_PERDUE
}

enum LeadTypeClient {
  COLLECTIVITE_TERRITORIALE
  PARTICULIER_B2C
  ENTREPRISE_PRIVEE_B2B
  GOUVERNEMENT_SECTEUR_PUBLIC
  HOTELS_ET_ESPACES_EVENEMENTIEL
  INSTITUTION_MULTILATERALE_OI
  AGENCE_DE_COOPERATION_OPERATEUR
  INSTITUTION_FINANCIERE_INTERNATIONALE_IFI
  ONG_ASSOCIATION_ACADEMIQUE
  NON_DETERMINE
}

/// Rôle du contact dans la décision d'achat
enum DecisionRole {
  DECIDEUR
  PRESCRIPTEUR
  INFLUENCEUR
  RELAI_INTERNE
  NON_DETERMINE
}

enum ActivityType {
  CALL
  EMAIL
  WHATSAPP
  MEETING
  NOTE
}

/// Statut d'une tâche / événement dans l'agenda du prospect
enum AgendaStatus {
  TODO
  IN_PROGRESS
  DONE
}

/// Type de période pour les objectifs commerciaux
enum GoalPeriodType {
  MONTH
  QUARTER
  SEMESTER
  YEAR
}

/// Objectif commercial par commercial et par période (Mois, Trimestre, Semestre, Année)
model SalesGoal {
  id                 String         @id @default(cuid())
  user               User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId             String
  company            Company        @relation(fields: [companyId], references: [id], onDelete: Cascade)
  companyId          String
  periodType         GoalPeriodType
  periodStart        DateTime
  periodEnd          DateTime
  targetConversions  Int            @default(0)
  targetRevenue      Float          @default(0)
  /// Utilisateur (manager/admin) ayant défini cet objectif
  setById            String?
  setBy              User?          @relation("SalesGoalSetBy", fields: [setById], references: [id], onDelete: SetNull)
  createdAt          DateTime       @default(now())
  updatedAt          DateTime       @updatedAt
  /// Mise en corbeille
  deletedAt          DateTime?
  deletedBy          User?          @relation("SalesGoalDeletedBy", fields: [deletedById], references: [id], onDelete: SetNull)
  deletedById        String?

  @@unique([userId, periodType, periodStart])
  @@index([companyId, deletedAt])
}

/// Événement de l'agenda : action à mener sur un prospect entreprise
model AgendaItem {
  id          String           @id @default(cuid())
  prospect    Prospect         @relation(fields: [prospectId], references: [id], onDelete: Cascade)
  prospectId  String
  contact     ProspectContact? @relation(fields: [contactId], references: [id], onDelete: SetNull)
  contactId   String?
  /// Utilisateur (commercial/membre) qui a créé cette tâche
  createdById String?
  createdBy   User?            @relation(fields: [createdById], references: [id], onDelete: SetNull)
  title       String
  description String?
  dueDate     DateTime
  status      AgendaStatus     @default(TODO)
  createdAt   DateTime         @default(now())

  @@index([prospectId])
  @@index([contactId])
}

/// Journal d'audit des actions CRM (mutations + authentification)
model UserActionLog {
  id         String   @id @default(cuid())
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId     String
  company    Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  companyId  String
  /// Code stable (ex: LEAD_CREATE, AUTH_LOGIN)
  action     String
  /// Type d'entité concernée (Lead, Client, User, …)
  entityType String?
  entityId   String?
  /// Libellé lisible en français
  summary    String
  /// Détails non sensibles (JSON)
  metadata   Json?
  createdAt  DateTime @default(now())

  @@index([userId, createdAt(sort: Desc)])
  @@index([companyId, createdAt(sort: Desc)])
}

/// Synthèse des ventes générée et historisée (téléchargeable PDF / Excel / Word)
model SalesReport {
  id          String   @id @default(cuid())
  title       String
  periodFrom  DateTime
  periodTo    DateTime
  /// Filtre source optionnel au moment de la génération
  source      String?
  /// Libellé du périmètre (Holding, nom filiale, etc.)
  scopeLabel  String?
  /// Snapshot JSON du SalesSummaryReport
  payload     Json
  /// Commercial ciblé (null = toutes les commerciales du périmètre)
  agentId     String?
  agent       User?    @relation("SalesReportAgent", fields: [agentId], references: [id], onDelete: SetNull)
  /// Société de rattachement (créateur / filtre single)
  companyId   String
  company     Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  createdById String
  createdBy   User     @relation("SalesReportCreatedBy", fields: [createdById], references: [id], onDelete: Cascade)
  createdAt   DateTime @default(now())
  /// Archivage (null = actif)
  archivedAt  DateTime?

  @@index([companyId, createdAt(sort: Desc)])
  @@index([createdById, createdAt(sort: Desc)])
  @@index([agentId])
  @@index([companyId, archivedAt])
}
